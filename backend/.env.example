# =============================================================================
# INTERNSAFE AI Service (FastAPI) — copy to backend/.env
# =============================================================================

# Cloudflare Worker base URL (callbacks after async AI jobs)
WORKER_BASE_URL=https://internsafe-api.dhilip17mk.workers.dev

# Shared secret with Worker — MUST match wrangler secret AI_SERVICE_SECRET
# Generate: openssl rand -hex 32
AI_SERVICE_SECRET=internsafe-dev-ai-secret-change-me

# This service listen address (npm run ai:dev uses port 8000)
# Worker AI_SERVICE_URL should point here locally:
#   http://127.0.0.1:8000
# Or your public tunnel URL in production:
#   https://xxxx.trycloudflare.com

# Redis / Celery (local)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# LLM (recommendations & assistant only — not used for fraud scores)
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Model pipelines
ENABLE_PADDLE_OCR=true
ENABLE_SPACY_NER=true
ENABLE_TRANSFORMERS_NLP=true
ENABLE_SENTENCE_EMBEDDINGS=true
SPACY_MODEL=en_core_web_sm
