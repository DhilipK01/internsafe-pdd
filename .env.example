# =============================================================================
# INTERNSAFE Flutter app — copy to .env in project root
# =============================================================================

# Deployed Cloudflare Worker (required)
API_BASE_URL=https://internsafe-api.dhilip17mk.workers.dev

# Share / App Links host (optional — defaults to host from API_BASE_URL)
SHARE_LINK_HOST=internsafe-api.dhilip17mk.workers.dev

# Google Sign-In — OAuth "Web application" client ID (NOT the Android client ID)
# https://console.cloud.google.com/apis/credentials
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Alias (optional, same Web client ID):
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# AI service URLs are NOT used by the Flutter app directly.
# Configure on Cloudflare Worker (wrangler secrets) and backend/.env instead.
# See ENVIRONMENT.md and backend/.env.example
# -----------------------------------------------------------------------------
